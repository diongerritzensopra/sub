{
  "manifest_version": 3,
  "name": "sub",
  "version": "0.1.0",
  "description": "snel uren boeken voor SAP My Timesheet.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "sub",
    "default_icon": {
      "16": "src/assets/icons/periscope-16.png",
      "48": "src/assets/icons/periscope-48.png",
      "128": "src/assets/icons/periscope-128.png"
    }
  },
  "icons": {
    "16": "src/assets/icons/periscope-16.png",
    "48": "src/assets/icons/periscope-48.png",
    "128": "src/assets/icons/periscope-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/icons/submarine-red-16.png",
        "src/assets/icons/submarine-red-48.png",
        "src/assets/icons/submarine-red-128.png",
        "src/assets/icons/submarine-green-16.png",
        "src/assets/icons/submarine-green-48.png",
        "src/assets/icons/submarine-green-128.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://p10mq7ma.launchpad.cfapps.eu10.hana.ondemand.com/site*"],
      "js": ["src/content/content-script.ts"],
      "run_at": "document_idle"
    }
  ]
}
